# Public site URL (used for SEO metadata, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.panyamcements.in

# ---- Enquiry / contact form email (https://resend.com) ----
# Without RESEND_API_KEY, forms work in development (logged to the server console)
# but return a "not configured" error in production.
RESEND_API_KEY=
# Must be an address on a domain verified in Resend, e.g. website@panyamcements.in
ENQUIRY_FROM_EMAIL=
# Comma-separated inboxes that receive each enquiry type
ENQUIRY_TO_SALES=marketing@panyamcements.in
ENQUIRY_TO_CORPORATE=pcmilcao@panyamcements.in
ENQUIRY_TO_CAREERS=pcmilcao@panyamcements.in

# ---- Sanity CMS (optional; blog + gallery fall back to src/data when empty) ----
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Optional: serve investor PDFs from another origin/bucket instead of /public
NEXT_PUBLIC_DOCS_ORIGIN=
